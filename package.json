{
  "name": "local-notes-desktop",
  "productName": "鸢笺",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "本地优先、自由打开文件的 Markdown 笔记软件",
  "author": "Yuanjian contributors",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown src electron tests e2e scripts *.ts *.html *.json",
    "test": "vitest run",
    "test:headless": "vitest run --exclude tests/editor-browser.test.ts",
    "verify": "npm run typecheck && npm run test:headless && npm run build",
    "build": "vite build && node scripts/build-electron.mjs && node scripts/licenses.mjs",
    "test:e2e": "playwright test",
    "verify:sticky-ui": "node scripts/verify-sticky-headless.mjs",
    "verify:settings-layout": "node scripts/check-settings-layout.mjs",
    "verify:font-settings": "node scripts/check-font-settings.mjs",
    "verify:caret": "node scripts/check-caret-blink.mjs",
    "verify:editor-input": "node scripts/check-editor-input.mjs",
    "verify:preview-clicks": "node scripts/check-preview-clicks.mjs",
    "verify:sticky-native": "node scripts/check-sticky-native-hit.mjs",
    "verify:heading": "node scripts/check-heading-interactions.mjs",
    "verify:crlf": "node scripts/check-crlf-autosave.mjs",
    "verify:audit": "node scripts/check-audit-interactions.mjs",
    "verify:workflow": "node scripts/check-workflow.mjs",
    "verify:graph-loading": "node scripts/check-graph-loading.mjs",
    "verify:built-hidden": "node scripts/check-built-hidden.mjs",
    "verify:transfer-hidden": "node scripts/check-transfer-hidden.mjs",
    "verify:transfer-ui": "node scripts/check-transfer-ui.mjs",
    "verify:table-input": "node scripts/check-table-input.mjs",
    "package": "npm run verify && node scripts/package.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/markdown": "^1.0.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.0",
    "cytoscape": "^3.0.0",
    "dompurify": "^3.0.0",
    "fflate": "^0.8.0",
    "highlight.js": "^11.0.0",
    "katex": "^0.19.0",
    "lucide-react": "1.61.0",
    "markdown-it": "^14.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "node-diff3": "3.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "^7.0.0",
    "turndown-plugin-gfm": "^1.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@types/cytoscape": "^3.0.0",
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.0.0",
    "@types/markdown-it-footnote": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "local.yuanjian.notes",
    "productName": "鸢笺",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "executableName": "Yuanjian",
      "icon": "build/icon.ico",
      "artifactName": "Yuanjian-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "guid": "58a1b8fc-d62d-5703-a7f1-b5d93aedb8d7",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 笔记",
        "role": "Editor"
      }
    ]
  }
}
