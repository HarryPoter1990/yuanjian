{
  "name": "local-notes-desktop",
  "productName": "轻笺",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地优先、自由打开文件的 Markdown 笔记软件",
  "author": "Local Notes contributors",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown src electron tests e2e scripts *.ts *.html *.json",
    "test": "vitest run",
    "build": "vite build && node scripts/build-electron.mjs && node scripts/licenses.mjs",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/markdown": "^1.0.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.0",
    "cytoscape": "^3.0.0",
    "dompurify": "^3.0.0",
    "fflate": "^0.8.0",
    "highlight.js": "^11.0.0",
    "katex": "^0.19.0",
    "lucide-react": "1.61.0",
    "markdown-it": "^14.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "node-diff3": "3.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "^7.0.0",
    "turndown-plugin-gfm": "^1.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@types/cytoscape": "^3.0.0",
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.0.0",
    "@types/markdown-it-footnote": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "local.qingjian.notes",
    "productName": "轻笺",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Qingjian-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 笔记",
        "role": "Editor"
      }
    ]
  }
}
